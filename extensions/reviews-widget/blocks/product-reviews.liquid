{%- comment -%}
  VCOM Reviews — configurações via app (shop.metafields.vcom_reviews.storefront_settings)
{%- endcomment -%}

{{ 'vcom-layouts.css' | asset_url | stylesheet_tag }}

{%- assign bid = block.id -%}
{%- assign cfg = shop.metafields.vcom_reviews.storefront_settings.value -%}

{%- assign ds = cfg.data_source | default: 'auto' -%}
{%- assign s_background = cfg.background | default: '#ffffff' -%}
{%- assign s_pad_top = cfg.section_padding_top | default: 24 -%}
{%- assign s_pad_bottom = cfg.section_padding_bottom | default: 24 -%}
{%- assign s_pad_sides = cfg.section_padding_sides | default: 16 -%}
{%- assign s_trusted_show = cfg.trusted_show_header -%}
{%- if s_trusted_show == nil -%}{%- assign s_trusted_show = true -%}{%- endif -%}
{%- assign s_header_style = cfg.header_style | default: 'aggregate' -%}
{%- assign s_section_headline = cfg.section_headline | default: 'TRUSTED BY THOUSANDS' -%}
{%- assign s_section_headline_size = cfg.section_headline_font_size | default: 22 -%}
{%- assign s_header_rating_color = cfg.header_rating_color | default: '#1d8a42' -%}
{%- assign s_header_stars_color = cfg.header_stars_color | default: '#e8a317' -%}
{%- assign s_header_summary_color = cfg.header_summary_color | default: '#6b6b6b' -%}
{%- assign s_header_based_on_prefix = cfg.header_based_on_prefix | default: 'Based on' -%}
{%- assign s_header_show_trustpilot = cfg.header_show_trustpilot_logo -%}
{%- if s_header_show_trustpilot == nil -%}{%- assign s_header_show_trustpilot = true -%}{%- endif -%}
{%- assign s_trustpilot_logo_h = cfg.header_trustpilot_logo_height | default: 22 -%}
{%- assign s_review_title_color = cfg.review_title_color | default: '#000000' -%}
{%- assign s_review_body_color = cfg.review_body_color | default: '#6b6b6b' -%}
{%- assign s_review_title_size = cfg.review_title_font_size | default: 17 -%}
{%- assign s_review_body_size = cfg.review_body_font_size | default: 15 -%}
{%- assign s_review_meta_color = cfg.review_meta_color | default: '#888888' -%}
{%- assign s_card_bg = cfg.card_background | default: '#ffffff' -%}
{%- assign s_card_border = cfg.card_border_color | default: 'rgba(0,0,0,0.08)' -%}
{%- assign s_card_radius = cfg.card_border_radius | default: 10 -%}
{%- assign s_card_pad = cfg.card_padding | default: 20 -%}
{%- assign s_cards_gap = cfg.cards_gap | default: 16 -%}
{%- assign s_form_show_success = cfg.review_form_show_success -%}
{%- if s_form_show_success == nil -%}{%- assign s_form_show_success = true -%}{%- endif -%}
{%- assign s_success_bg = cfg.review_form_success_bg | default: '#ecfdf5' -%}
{%- assign s_success_border = cfg.review_form_success_border | default: '#a7f3d0' -%}
{%- assign s_success_text = cfg.review_form_success_text_color | default: '#065f46' -%}
{%- assign s_success_icon = cfg.review_form_success_icon_color | default: '#065f46' -%}
{%- assign s_success_show_icon = cfg.review_form_success_show_icon -%}
{%- if s_success_show_icon == nil -%}{%- assign s_success_show_icon = true -%}{%- endif -%}
{%- assign s_success_radius = cfg.review_form_success_border_radius | default: 10 -%}
{%- assign s_success_font = cfg.review_form_success_font_size | default: 15 -%}
{%- assign s_form_panel_bg = cfg.form_panel_background | default: '#f9fafb' -%}
{%- assign s_form_panel_border = cfg.form_panel_border_color | default: '#e5e7eb' -%}
{%- assign s_form_panel_radius = cfg.form_panel_border_radius | default: 10 -%}
{%- assign s_form_label = cfg.form_label_color | default: '#111111' -%}
{%- assign s_form_input_border = cfg.form_input_border_color | default: '#d1d5db' -%}
{%- assign s_trusted_after = cfg.trusted_text_after | default: 'is trusted by over' -%}
{%- assign s_trusted_highlight = cfg.trusted_text_highlight | default: '28k+' -%}
{%- assign s_trusted_highlight_color = cfg.trusted_highlight_color | default: '#1d8a42' -%}
{%- assign s_trusted_text_color = cfg.trusted_text_color | default: '#000000' -%}
{%- assign s_trusted_check_color = cfg.trusted_checkmark_color | default: '#1d8a42' -%}
{%- assign s_trusted_font_size = cfg.trusted_font_size | default: 15 -%}
{%- assign s_trusted_mb = cfg.trusted_margin_bottom | default: 16 -%}
{%- assign star_color = cfg.stars_color | default: '#1d8a42' -%}
{%- assign star_empty_color = cfg.stars_empty_color | default: '#dcdce6' -%}
{%- assign s_show_verified = cfg.show_verified -%}
{%- if s_show_verified == nil -%}{%- assign s_show_verified = true -%}{%- endif -%}
{%- assign s_verified_label = cfg.verified_label | default: 'Verified Buyer' -%}
{%- assign verified_color = cfg.verified_icon_color | default: '#1d8a42' -%}
{%- assign s_show_images = cfg.show_images -%}
{%- if s_show_images == nil -%}{%- assign s_show_images = true -%}{%- endif -%}
{%- assign text_max_chars = cfg.reviews_text_max_chars | default: 150 -%}
{%- assign title_max_chars = cfg.reviews_title_max_chars | default: 80 -%}
{%- assign reviews_per_page = cfg.reviews_per_page | default: 6 -%}
{%- assign s_cols_mobile = cfg.reviews_columns_mobile | default: 1 -%}
{%- assign s_cols_desktop = cfg.reviews_columns_desktop | default: 3 -%}
{%- if s_cols_mobile < 1 -%}{%- assign s_cols_mobile = 1 -%}{%- endif -%}
{%- if s_cols_mobile > 2 -%}{%- assign s_cols_mobile = 2 -%}{%- endif -%}
{%- if s_cols_desktop < 1 -%}{%- assign s_cols_desktop = 1 -%}{%- endif -%}
{%- if s_cols_desktop > 4 -%}{%- assign s_cols_desktop = 4 -%}{%- endif -%}
{%- assign s_pag_active = cfg.pagination_active_color | default: '#1d8a42' -%}
{%- assign s_pag_inactive = cfg.pagination_inactive_color | default: '#dcdce6' -%}
{%- assign s_show_empty = cfg.show_empty_message -%}
{%- if s_show_empty == nil -%}{%- assign s_show_empty = false -%}{%- endif -%}
{%- assign s_empty_message = cfg.empty_message | default: 'Adicione avaliações no app VCOM Reviews.' -%}
{%- assign s_show_review_form = cfg.show_review_form -%}
{%- if s_show_review_form == nil -%}{%- assign s_show_review_form = true -%}{%- endif -%}
{%- assign s_form_success = cfg.review_form_success_message | default: '' -%}
{%- assign s_form_show_images = cfg.review_form_show_images -%}
{%- if s_form_show_images == nil -%}{%- assign s_form_show_images = true -%}{%- endif -%}
{%- assign s_form_images_max = cfg.review_form_images_max | default: 5 -%}
{%- assign s_form_btn = cfg.review_form_btn_text | default: '' -%}
{%- assign s_form_rating_label = cfg.review_form_rating_label | default: '' -%}
{%- assign s_form_title_label = cfg.review_form_title_label | default: '' -%}
{%- assign s_form_title_ph = cfg.review_form_title_placeholder | default: '' -%}
{%- assign s_form_body_label = cfg.review_form_body_label | default: '' -%}
{%- assign s_form_body_ph = cfg.review_form_body_placeholder | default: '' -%}
{%- assign s_form_images_label = cfg.review_form_images_label | default: '' -%}
{%- assign s_form_images_btn = cfg.review_form_images_btn_text | default: '' -%}
{%- assign s_form_author_label = cfg.review_form_author_label | default: '' -%}
{%- assign s_form_author_ph = cfg.review_form_author_placeholder | default: '' -%}
{%- assign s_form_submit = cfg.review_form_submit_text | default: '' -%}
{%- assign s_form_cancel = cfg.review_form_cancel_text | default: '' -%}
{%- assign s_footer_show = cfg.footer_show -%}
{%- if s_footer_show == nil -%}{%- assign s_footer_show = true -%}{%- endif -%}
{%- assign s_footer_prefix = cfg.footer_prefix | default: 'Rated' -%}
{%- assign s_footer_rating = cfg.footer_rating | default: '4.8' -%}
{%- assign s_footer_middle = cfg.footer_middle | default: '/ 5 based on' -%}
{%- assign s_footer_total = cfg.footer_total | default: '11 customers' -%}
{%- assign s_footer_suffix = cfg.footer_suffix | default: '.' -%}
{%- assign s_footer_text_color = cfg.footer_text_color | default: '#000000' -%}
{%- assign s_layout = cfg.layout | default: 'trustpilot_carousel' -%}

{%- assign all_reviews = nil -%}
{%- if shop.metaobjects.review -%}
  {%- assign all_reviews = shop.metaobjects.review.values -%}
{%- elsif shop.metaobjects["$app:review"] -%}
  {%- assign all_reviews = shop.metaobjects["$app:review"].values -%}
{%- endif -%}
{%- assign use_proxy_reviews = false -%}
{%- if all_reviews == blank -%}
  {%- assign use_proxy_reviews = true -%}
{%- endif -%}

{%- assign reviews_context = 'homepage' -%}
{%- if ds == 'product' -%}
  {%- assign reviews_context = 'product' -%}
{%- elsif ds == 'auto' and request.page_type == 'product' -%}
  {%- assign reviews_context = 'product' -%}
{%- endif -%}

{%- assign has_reviews = false -%}

{%- assign images_initial = 3 -%}

{%- assign submit_placement = 'homepage' -%}
{%- assign submit_product_id = '' -%}
{%- if request.page_type == 'product' and product != blank -%}
  {%- assign submit_placement = 'product' -%}
  {%- assign submit_product_id = product.id -%}
{%- elsif ds == 'product' and product != blank -%}
  {%- assign submit_placement = 'product' -%}
  {%- assign submit_product_id = product.id -%}
{%- endif -%}

{%- assign review_count = 0 -%}
{%- assign rating_avg = 0 -%}
{%- assign rating_sum = 0 -%}
{%- assign dist_1 = 0 -%}
{%- assign dist_2 = 0 -%}
{%- assign dist_3 = 0 -%}
{%- assign dist_4 = 0 -%}
{%- assign dist_5 = 0 -%}
{%- if all_reviews != blank -%}
  {%- for r in all_reviews -%}
    {%- assign r_st = 'approved' -%}
    {%- if r.status != blank -%}{%- assign r_st = r.status.value | default: r.status -%}{%- endif -%}
    {%- if r_st == 'pending' or r_st == 'rejected' -%}{%- continue -%}{%- endif -%}
    {%- assign r_pl = 'homepage' -%}
    {%- if r.placement != blank -%}{%- assign r_pl = r.placement.value | default: r.placement -%}{%- endif -%}
    {%- if reviews_context == 'homepage' -%}
      {%- unless r_pl == 'homepage' -%}{%- continue -%}{%- endunless -%}
    {%- else -%}
      {%- unless r_pl == 'product' -%}{%- continue -%}{%- endunless -%}
      {%- assign r_pid = '' -%}
      {%- if r.product_id != blank -%}{%- assign r_pid = r.product_id.value | default: r.product_id -%}{%- endif -%}
      {%- unless product != blank and r_pid == product.id -%}{%- continue -%}{%- endunless -%}
    {%- endif -%}
    {%- assign review_count = review_count | plus: 1 -%}
    {%- assign r_val_raw = r.rating.value | default: r.rating | replace: ',', '.' -%}
    {%- assign rating_sum = rating_sum | plus: r_val_raw | plus: 0.0 -%}
    {%- assign r_stars_int = r_val_raw | plus: 0 | round -%}
    {%- if r_stars_int == 1 -%}{%- assign dist_1 = dist_1 | plus: 1 -%}
    {%- elsif r_stars_int == 2 -%}{%- assign dist_2 = dist_2 | plus: 1 -%}
    {%- elsif r_stars_int == 3 -%}{%- assign dist_3 = dist_3 | plus: 1 -%}
    {%- elsif r_stars_int == 4 -%}{%- assign dist_4 = dist_4 | plus: 1 -%}
    {%- else -%}{%- assign dist_5 = dist_5 | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if review_count > 0 -%}
    {%- assign rating_avg = rating_sum | times: 1.0 | divided_by: review_count -%}
    {%- assign has_reviews = true -%}
  {%- else -%}
    {%- assign has_reviews = false -%}
  {%- endif -%}
{%- endif -%}
{%- assign total_pages = review_count | plus: reviews_per_page | minus: 1 | divided_by: reviews_per_page -%}
{%- if total_pages < 1 -%}{%- assign total_pages = 1 -%}{%- endif -%}

<div id="vcom-reviews-{{ bid }}" class="product-reviews vcom-reviews-app-block vcom-layout--{{ s_layout }}" style="background:{{ s_background}};scroll-margin-top:96px;" data-layout="{{ s_layout }}">
  <style>
    #vcom-reviews-{{ bid }} .product-reviews__card{background:{{ s_card_bg }};border:1px solid {{ s_card_border }};border-radius:{{ s_card_radius }}px;padding:{{ s_card_pad }}px}
    #vcom-reviews-{{ bid }} .product-reviews__wrap{gap:{{ s_cards_gap }}px !important}
    #vcom-reviews-{{ bid }} .product-reviews__title{color:{{ s_review_title_color }};font-size:{{ s_review_title_size }}px;font-weight:800}
    #vcom-reviews-{{ bid }} .product-reviews__text{color:{{ s_review_body_color }};font-size:{{ s_review_body_size }}px;font-weight:400}
    #vcom-reviews-{{ bid }} .product-reviews__meta{color:{{ s_review_meta_color }}}
    #vcom-reviews-{{ bid }} .product-reviews__form-outer{background:{{ s_form_panel_bg }};border:1px solid {{ s_form_panel_border }};border-radius:{{ s_form_panel_radius }}px}
    #vcom-reviews-{{ bid }} .product-reviews__form-row label{color:{{ s_form_label }}}
    #vcom-reviews-{{ bid }} .product-reviews__form-row input,#vcom-reviews-{{ bid }} .product-reviews__form-row textarea{border-color:{{ s_form_input_border }}}
    #vcom-reviews-{{ bid }} .product-reviews__form-success{background:{{ s_success_bg }};border:1px solid {{ s_success_border }};border-radius:{{ s_success_radius }}px;color:{{ s_success_text }};font-size:{{ s_success_font }}px}
    #vcom-reviews-{{ bid }} .product-reviews__form-success svg{stroke:{{ s_success_icon }}}
    #vcom-reviews-{{ bid }} .product-reviews__trustpilot-logo{height:{{ s_trustpilot_logo_h }}px;width:auto}
    #vcom-reviews-{{ bid }} .product-reviews__section-title{font-size:{{ s_section_headline_size }}px}
    @media (max-width:991px){
      #vcom-reviews-{{ bid }}.vcom-layout--trustpilot_grid .product-reviews__wrap,
      #vcom-reviews-{{ bid }}.vcom-layout--trustpilot_mosaic .product-reviews__wrap{
        grid-template-columns:repeat({{ s_cols_mobile }},minmax(0,1fr));
        grid-auto-flow:row;
        overflow:visible;
        scroll-snap-type:none;
      }
      {%- if s_cols_mobile == 1 -%}
      #vcom-reviews-{{ bid }}.vcom-layout--trustpilot_carousel .product-reviews__wrap{
        display:grid;
        grid-auto-flow:column;
        grid-auto-columns:85%;
        grid-template-columns:unset;
        overflow-x:auto;
        scroll-snap-type:x mandatory;
      }
      {%- else -%}
      #vcom-reviews-{{ bid }}.vcom-layout--trustpilot_carousel .product-reviews__wrap{
        display:grid;
        grid-template-columns:repeat({{ s_cols_mobile }},minmax(0,1fr));
        grid-auto-flow:row;
        grid-auto-columns:initial;
        overflow:visible;
        scroll-snap-type:none;
      }
      {%- endif -%}
    }
    @media (min-width:992px){
      #vcom-reviews-{{ bid }}.vcom-layout--trustpilot_carousel .product-reviews__wrap,
      #vcom-reviews-{{ bid }}.vcom-layout--trustpilot_grid .product-reviews__wrap,
      #vcom-reviews-{{ bid }}.vcom-layout--trustpilot_mosaic .product-reviews__wrap{
        display:grid;
        grid-template-columns:repeat({{ s_cols_desktop }},minmax(0,1fr));
        grid-auto-flow:row;
        grid-auto-columns:initial;
        overflow:visible;
        scroll-snap-type:none;
      }
    }
  </style>
  <div class="vcom-reviews-container" style="max-width:1200px;margin:0 auto;padding:0 16px;">
    <div class="product-reviews__inner" style="padding:{{ s_pad_top }}px {{ s_pad_sides }}px {{ s_pad_bottom }}px;">

      {%- if s_trusted_show -%}
        {%- if s_header_style == 'aggregate' -%}
          {%- assign display_rating = s_footer_rating -%}
          {%- if has_reviews -%}{%- assign display_rating = rating_avg | round: 1 -%}{%- endif -%}
          {%- assign header_stars = display_rating | plus: 0.0 -%}
          <header class="product-reviews__section-head" style="margin-bottom:{{ s_trusted_mb }}px;">
            <h2 class="product-reviews__section-title">{{ s_section_headline }}</h2>
            <div class="product-reviews__section-summary">
              {%- if s_header_show_trustpilot -%}
                <img
                  class="product-reviews__trustpilot-logo"
                  src="{{ 'trustpilot-logo.svg' | asset_url }}"
                  alt="Trustpilot"
                  height="{{ s_trustpilot_logo_h }}"
                  loading="lazy"
                  style="height:{{ s_trustpilot_logo_h }}px;width:auto;"
                >
              {%- endif -%}
              <span class="product-reviews__section-score" style="color:{{ s_header_rating_color }};">{{ display_rating }}</span>
              <div class="product-reviews__section-stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- assign star_min = i | minus: 1 | times: 1.0 -%}
                  {%- if header_stars >= i -%}
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ s_header_stars_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                  {%- elsif header_stars > star_min -%}
                    {%- assign pct = header_stars | minus: star_min -%}
                    {%- assign fill_width = pct | times: 32 -%}
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_empty_color }}"/><rect width="{{ fill_width }}" height="32" fill="{{ s_header_stars_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_empty_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <span class="product-reviews__section-count" style="color:{{ s_header_summary_color }};">
                {%- if has_reviews -%}
                  {{ s_header_based_on_prefix }} {{ review_count }}{% if review_count >= 1000 %}+{% endif %} reviews
                {%- else -%}
                  {{ s_header_based_on_prefix }} {{ s_footer_total }}
                {%- endif -%}
              </span>
            </div>
          </header>
        {%- else -%}
          <div class="product-reviews__trusted" style="display:flex;justify-content:center;align-items:center;gap:6px;font-size:{{ s_trusted_font_size }}px;color:{{ s_trusted_text_color}};text-align:center;flex-wrap:wrap;margin-bottom:{{ s_trusted_mb }}px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="{{ s_trusted_check_color}}" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M22 12c0-5.5228-4.4772-10-10-10S2 6.4772 2 12s4.4772 10 10 10 10-4.4772 10-10Zm-5.2929-3.7071a1 1 0 0 1 0 1.4142l-6 6a1 1 0 0 1-1.4142 0l-3-3a1 1 0 1 1 1.4142-1.4142L11 13.5858l5.2929-5.2929a1 1 0 0 1 1.4142 0Z"/></svg>
            <span style="display:inline-flex;align-items:center;flex-wrap:wrap;justify-content:center;">
              {{ shop.name }} {{ s_trusted_after}}
              <span style="color:{{ s_trusted_highlight_color}};margin-left:4px;">{{ s_trusted_highlight}}</span>
            </span>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if has_reviews -%}
        <style>#vcom-reviews-{{ bid }} .product-reviews__verified{color:{{ verified_color }}}#vcom-reviews-{{ bid }} .product-reviews__images{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}#vcom-reviews-{{ bid }} .product-reviews__image-link{display:block;border-radius:8px;overflow:hidden;border:1px solid rgba(0,0,0,.08);cursor:pointer;background:none;padding:0;margin:0;font:inherit;text-align:left}#vcom-reviews-{{ bid }} .product-reviews__image{width:80px;height:80px;object-fit:cover;display:block;pointer-events:none}#vcom-reviews-{{ bid }} .product-reviews__image-more{width:80px;height:80px;min-width:80px;min-height:80px;border-radius:8px;border:1px solid rgba(0,0,0,.08);background:rgba(0,0,0,.06);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:#555}#vcom-reviews-{{ bid }} .product-reviews__image-link--hidden{display:none}#vcom-reviews-{{ bid }} .product-reviews__images.is-expanded .product-reviews__image-link--hidden{display:block}#vcom-reviews-{{ bid }} .product-reviews__images.is-expanded .product-reviews__image-see-more{display:none!important}#vcom-reviews-{{ bid }} .product-reviews__images.is-expanded .product-reviews__image-see-less{display:inline-block!important}#vcom-reviews-{{ bid }} .product-reviews__image-see-less{display:none;width:100%}#vcom-reviews-{{ bid }} .product-reviews__text-wrap{margin:0 0 10px}#vcom-reviews-{{ bid }} .product-reviews__text-more,#vcom-reviews-{{ bid }} .product-reviews__text-less{background:none;border:none;padding:0;font-size:13px;font-weight:600;color:{{ star_color}};cursor:pointer;margin-top:4px;text-decoration:underline}#vcom-reviews-{{ bid }} .product-reviews__image-modal{position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.85);display:flex;align-items:center;justify-content:center;padding:24px;opacity:0;visibility:hidden;transition:opacity .25s,visibility .25s}#vcom-reviews-{{ bid }} .product-reviews__image-modal.is-open{opacity:1;visibility:visible}#vcom-reviews-{{ bid }} .product-reviews__image-modal-inner{position:relative;max-width:90vw;max-height:90vh}#vcom-reviews-{{ bid }} .product-reviews__image-modal img{max-width:100%;max-height:85vh;width:auto;height:auto;object-contain;display:block;border-radius:8px}#vcom-reviews-{{ bid }} .product-reviews__image-modal-close{position:absolute;top:-44px;right:0;width:36px;height:36px;border:none;background:rgba(255,255,255,.2);color:#fff;border-radius:50%;cursor:pointer;font-size:24px;line-height:1;padding:0}#vcom-reviews-{{ bid }}:not(.vcom-layout--trustpilot_list) .product-reviews__avatar,#vcom-reviews-{{ bid }}:not(.vcom-layout--trustpilot_list) .product-reviews__head{display:none}#vcom-reviews-{{ bid }}.vcom-layout--trustpilot_list .product-reviews__stars--default{display:none}#vcom-reviews-{{ bid }}.vcom-layout--trustpilot_list .product-reviews__meta-author{display:none}</style>
        {%- if s_layout == 'trustpilot_split' -%}
        <div class="vcom-split">
          <aside class="vcom-split__summary" aria-label="Resumo das avaliações">
            <div class="vcom-split__score">{{ rating_avg | round: 1 }}</div>
            <div class="product-reviews__stars" style="justify-content:center;margin-bottom:8px;" aria-hidden="true">
              {%- assign split_stars = rating_avg | plus: 0.0 -%}
              {%- for i in (1..5) -%}
                {%- assign star_min = i | minus: 1 | times: 1.0 -%}
                {%- if split_stars >= i -%}
                  <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                {%- elsif split_stars > star_min -%}
                  {%- assign pct = split_stars | minus: star_min -%}
                  {%- assign fill_width = pct | times: 32 -%}
                  <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_empty_color }}"/><rect width="{{ fill_width }}" height="32" fill="{{ star_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_empty_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="vcom-split__label">TrustScore</p>
            {%- for star_level in (5..1) -%}
              {%- assign dist_count = dist_5 -%}
              {%- if star_level == 4 -%}{%- assign dist_count = dist_4 -%}
              {%- elsif star_level == 3 -%}{%- assign dist_count = dist_3 -%}
              {%- elsif star_level == 2 -%}{%- assign dist_count = dist_2 -%}
              {%- elsif star_level == 1 -%}{%- assign dist_count = dist_1 -%}
              {%- endif -%}
              {%- assign bar_pct = 0 -%}
              {%- if review_count > 0 -%}{%- assign bar_pct = dist_count | times: 100.0 | divided_by: review_count -%}{%- endif -%}
              <div class="vcom-bar-row">
                <span>{{ star_level }}</span>
                <div class="vcom-bar-track"><div class="vcom-bar-fill" style="width:{{ bar_pct }}%;background:{{ star_color }};"></div></div>
                <span>{{ dist_count }}</span>
              </div>
            {%- endfor -%}
            <p class="vcom-split__count">{{ review_count }} avaliações</p>
          </aside>
          <div class="vcom-split__reviews">
        {%- endif -%}
        <div class="product-reviews__wrap" id="vcom-reviews-grid-{{ block.id }}" data-proxy-url="/apps/vcom-reviews/reviews?placement={{ submit_placement }}&product_id={{ submit_product_id | replace: 'gid://shopify/Product/', '' }}" data-layout="{{ s_layout }}">
          
          {%- assign approved_index = 0 -%}
          {%- for review in all_reviews -%}
            {%- assign r_status = 'approved' -%}
            {%- if review.status != blank -%}{%- assign r_status = review.status.value | default: review.status -%}{%- endif -%}
            {%- if r_status == 'pending' or r_status == 'rejected' -%}{%- continue -%}{%- endif -%}
            {%- assign r_pl = 'homepage' -%}
            {%- if review.placement != blank -%}{%- assign r_pl = review.placement.value | default: review.placement -%}{%- endif -%}
            {%- if reviews_context == 'homepage' -%}
              {%- unless r_pl == 'homepage' -%}{%- continue -%}{%- endunless -%}
            {%- else -%}
              {%- unless r_pl == 'product' -%}{%- continue -%}{%- endunless -%}
              {%- assign r_pid = '' -%}
              {%- if review.product_id != blank -%}{%- assign r_pid = review.product_id.value | default: review.product_id -%}{%- endif -%}
              {%- unless product != blank and r_pid == product.id -%}{%- continue -%}{%- endunless -%}
            {%- endif -%}
            {%- assign page_num = approved_index | divided_by: reviews_per_page | plus: 1 -%}
            {%- assign approved_index = approved_index | plus: 1 -%}
            {%- assign stars_raw = '5' -%}
            {%- if review.rating != blank -%}
              {%- assign stars_raw = review.rating.value | default: review.rating | replace: ',', '.' -%}
            {%- endif -%}
            {%- assign stars = stars_raw | plus: 0.0 -%}
            {%- if stars == 0 -%}{%- assign stars = 5 -%}{%- endif -%}
            {%- assign verified = false -%}
            {%- if review.verified_buyer != blank -%}{%- assign verified = review.verified_buyer.value | default: review.verified_buyer -%}{%- endif -%}
            {%- assign r_title = '' -%}{%- if review.title != blank -%}{%- assign r_title = review.title.value | default: review.title -%}{%- endif -%}
            {%- assign r_body = '' -%}{%- if review.body != blank -%}{%- assign r_body = review.body.value | default: review.body -%}{%- endif -%}
            {%- assign r_author = '' -%}{%- if review.author != blank -%}{%- assign r_author = review.author.value | default: review.author -%}{%- endif -%}
            {%- assign r_time = '' -%}{%- if review.time != blank -%}{%- assign r_time = review.time.value | default: review.time -%}{%- endif -%}
            {%- assign r_images = nil -%}
            {%- if review.images != blank -%}
              {%- assign r_images = review.images.value | default: review.images -%}
            {%- endif -%}
            {%- assign r_images = r_images | default: nil -%}
            <article class="product-reviews__card product-reviews__card--page-{{ page_num }}" data-page="{{ page_num }}"{% if total_pages > 1 and page_num > 1 %} style="display:none"{% endif %}>
