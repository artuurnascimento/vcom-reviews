                  {%- elsif stars > star_min -%}
                    {%- assign pct = stars | minus: star_min -%}
                    {%- assign fill_width = pct | times: 32 -%}
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_empty_color }}"/><rect width="{{ fill_width }}" height="32" fill="{{ star_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_empty_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                  {%- endif -%}
                {%- endfor -%}
                </div>
              </div>
              <div class="product-reviews__stars product-reviews__stars--default" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- assign star_min = i | minus: 1 | times: 1.0 -%}
                  {%- if stars >= i -%}
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                  {%- elsif stars > star_min -%}
                    {%- assign pct = stars | minus: star_min -%}
                    {%- assign fill_width = pct | times: 32 -%}
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_empty_color }}"/><rect width="{{ fill_width }}" height="32" fill="{{ star_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ star_empty_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if s_show_verified and verified -%}
                <div class="product-reviews__verified">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16"><path fill="{{ verified_color }}" d="M1 12C1 5.925 5.925 1 12 1s11 4.925 11 11-4.925 11-11 11S1 18.075 1 12Zm10.207 4.207 7-7-1.414-1.414L10.5 14.086 7.207 10.793 5.793 12.207l4 4c.188.188.442.293.707.293s.519-.105.707-.293Z"/></svg>
                  <span>{{ s_verified_label}}</span>
                </div>
              {%- endif -%}
              {%- if r_title != blank -%}
                {%- assign r_title_len = r_title.size -%}
                <h3 class="product-reviews__title">{{ r_title | slice: 0, title_max_chars }}{% if r_title_len > title_max_chars %}...{% endif %}</h3>
              {%- endif -%}
              {%- if r_body != blank -%}
                {%- assign r_body_len = r_body.size -%}
                <div class="product-reviews__text-wrap"{% if r_body_len > text_max_chars %} data-full="{{ r_body | escape }}" data-limit="{{ text_max_chars }}"{% endif %}>
                  <p class="product-reviews__text">{{ r_body | slice: 0, text_max_chars }}{% if r_body_len > text_max_chars %}...{% endif %}</p>
                  {%- if r_body_len > text_max_chars -%}
                  <button type="button" class="product-reviews__text-more">{{ 'product_reviews.form.view_more' | t | default: 'See more' }}</button>
                  <button type="button" class="product-reviews__text-less" style="display:none">{{ 'product_reviews.form.view_less' | t | default: 'See less' }}</button>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if s_show_images and r_images != blank and r_images.size > 0 -%}
                {%- assign r_images_count = 0 -%}
                {%- for img in r_images -%}{%- if img != blank -%}{%- assign r_images_count = r_images_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
                {%- assign r_images_count = r_images_count | at_most: 6 -%}
                {%- assign r_images_hidden = 0 -%}{%- if r_images_count > images_initial -%}{%- assign r_images_hidden = r_images_count | minus: images_initial -%}{%- endif -%}
                <div class="product-reviews__images{% if r_images_hidden > 0 %} product-reviews__images--collapsible{% endif %}" data-review-images data-initial="{{ images_initial }}">
                  {%- assign img_count = 0 -%}
                  {%- for img in r_images -%}
                    {%- if img != blank and img_count < 6 -%}
                      {%- assign img_index = img_count | plus: 1 -%}
                      <button type="button" class="product-reviews__image-link{% if img_index > images_initial %} product-reviews__image-link--hidden{% endif %}" data-image-src="{{ img | image_url: width: 1200 }}" aria-label="{{ 'product_reviews.form.view_image' | t | default: 'View image' }}">
                        <img src="{{ img | image_url: width: 200 }}" alt="" loading="lazy" width="80" height="80" class="product-reviews__image">
                      </button>
                      {%- assign img_count = img_count | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if r_images_hidden > 0 -%}
                    <button type="button" class="product-reviews__image-see-more" data-hidden-count="{{ r_images_hidden }}" style="width:80px;height:80px;min-width:80px;min-height:80px;border-radius:8px;border:1px solid rgba(0,0,0,.08);background:rgba(0,0,0,.06);cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#555;transition:background .2s,color .2s;padding:4px;margin:0;font:inherit;line-height:1.2;text-align:center;">
                      <span>{{ 'product_reviews.form.view_more' | t | default: 'See more' }}</span><span>+{{ r_images_hidden }}</span>
                    </button>
                    <button type="button" class="product-reviews__image-see-less" style="padding:6px 12px;border:1px solid rgba(0,0,0,.15);background:#fff;border-radius:6px;font-size:13px;font-weight:600;color:#555;cursor:pointer;margin-top:8px;transition:background .2s,color .2s;">
                      {{ 'product_reviews.form.view_less' | t | default: 'See less' }}
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="product-reviews__meta">
                {%- if r_author != blank -%}<span class="product-reviews__meta-author">{{ r_author }}</span>{%- endif -%}
                {%- if r_author != blank and r_time != blank -%}<span class="product-reviews__meta-sep"> - </span>{%- endif -%}
                {%- if r_time != blank -%}<span>{{ r_time }}</span>{%- endif -%}
              </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- if s_layout == 'trustpilot_split' -%}
          </div>
        </div>
        {%- endif -%}

        <div class="product-reviews__image-modal" id="vcom-reviews-image-modal-{{ block.id }}" role="dialog" aria-modal="true" aria-label="Ver imagem">
          <div class="product-reviews__image-modal-inner">
            <button type="button" class="product-reviews__image-modal-close" aria-label="Fechar">&times;</button>
            <img src="" alt="" width="1200" height="1200" id="vcom-reviews-modal-img-{{ block.id }}">
          </div>
        </div>
        <script>
          (function(){
            var sid='{{ block.id }}';
            var root=document.getElementById('vcom-reviews-'+sid);
            var modal=document.getElementById('vcom-reviews-image-modal-'+sid);
            var modalImg=document.getElementById('vcom-reviews-modal-img-'+sid);
            if(!root||!modal||!modalImg)return;
            var btns=root.querySelectorAll('.product-reviews__image-link[data-image-src]');
            var closeBtn=modal.querySelector('.product-reviews__image-modal-close');
            function openModal(src){modalImg.src=src;modal.classList.add('is-open');document.body.style.overflow='hidden';}
            function closeModal(){modal.classList.remove('is-open');modalImg.src='';document.body.style.overflow='';}
            btns.forEach(function(b){b.addEventListener('click',function(e){e.preventDefault();var s=this.getAttribute('data-image-src');if(s)openModal(s);});});
            closeBtn&&closeBtn.addEventListener('click',closeModal);
            modal.addEventListener('click',function(e){if(e.target===modal)closeModal();});
            document.addEventListener('keydown',function(e){if(e.key==='Escape'&&modal.classList.contains('is-open'))closeModal();});
            root.querySelectorAll('.product-reviews__image-see-more').forEach(function(btn){btn.addEventListener('click',function(){var wrap=this.closest('.product-reviews__images');if(wrap)wrap.classList.add('is-expanded');});});
            root.querySelectorAll('.product-reviews__image-see-less').forEach(function(btn){btn.addEventListener('click',function(){var wrap=this.closest('.product-reviews__images');if(wrap)wrap.classList.remove('is-expanded');});});
            root.querySelectorAll('.product-reviews__text-more').forEach(function(btn){var wrap=btn.closest('.product-reviews__text-wrap');var p=wrap&&wrap.querySelector('.product-reviews__text');if(!wrap||!p||!wrap.dataset.full)return;btn.addEventListener('click',function(){p.textContent=wrap.dataset.full;btn.style.display='none';var less=wrap.querySelector('.product-reviews__text-less');if(less)less.style.display='inline';});});
            root.querySelectorAll('.product-reviews__text-less').forEach(function(btn){var wrap=btn.closest('.product-reviews__text-wrap');var p=wrap&&wrap.querySelector('.product-reviews__text');if(!wrap||!p||!wrap.dataset.full)return;var limit=parseInt(wrap.dataset.limit,10)||150;var full=wrap.dataset.full;var truncated=full.length>limit?full.slice(0,limit)+'...':full;btn.addEventListener('click',function(){p.textContent=truncated;btn.style.display='none';var more=wrap.querySelector('.product-reviews__text-more');if(more)more.style.display='inline';});});
          })();
        </script>

        {%- if total_pages > 1 -%}
          <div class="product-reviews__pagination" id="vcom-reviews-pagination-{{ block.id }}" style="display:flex;justify-content:center;gap:8px;margin-top:20px;flex-wrap:wrap;">
            {%- for p in (1..total_pages) -%}
              <button type="button" class="product-reviews__pagination-dot" data-page="{{ p }}" aria-label="Página {{ p }}" style="width:10px;height:10px;border-radius:50%;border:none;cursor:pointer;padding:0;transition:background .2s,transform .2s;background:{% if p == 1 %}{{ s_pag_active}}{% else %}{{ s_pag_inactive}}{% endif %};transform:{% if p == 1 %}scale(1.2){% else %}scale(1){% endif %};"></button>
            {%- endfor -%}
          </div>
          <script>
            !function(){var s='{{ block.id }}',g=document.getElementById('vcom-reviews-grid-'+s),p=document.getElementById('vcom-reviews-pagination-'+s);if(!g||!p)return;var c=g.querySelectorAll('.product-reviews__card'),d=p.querySelectorAll('.product-reviews__pagination-dot'),a='{{ s_pag_active}}',i='{{ s_pag_inactive}}';function go(n){c.forEach(function(x){x.style.display=x.dataset.page==n?'':'none'});d.forEach(function(x){x.style.background=x.dataset.page==n?a:i;x.style.transform=x.dataset.page==n?'scale(1.2)':'scale(1)'})}d.forEach(function(x){x.addEventListener('click',function(){go(this.dataset.page)})});go(1)}();
          </script>
        {%- endif -%}
      {%- else -%}
        <style>#vcom-reviews-{{ bid }} .product-reviews__verified{color:{{ verified_color }}}#vcom-reviews-{{ bid }}:not(.vcom-layout--trustpilot_list) .product-reviews__avatar,#vcom-reviews-{{ bid }}:not(.vcom-layout--trustpilot_list) .product-reviews__head{display:none}#vcom-reviews-{{ bid }}.vcom-layout--trustpilot_list .product-reviews__stars--default{display:none}#vcom-reviews-{{ bid }}.vcom-layout--trustpilot_list .product-reviews__meta-author{display:none}</style>
        <div class="product-reviews__wrap" id="vcom-reviews-grid-{{ block.id }}" data-proxy-url="/apps/vcom-reviews/reviews?placement={{ submit_placement }}&product_id={{ submit_product_id | replace: 'gid://shopify/Product/', '' }}" data-layout="{{ s_layout }}"></div>
        {%- if s_show_empty -%}
          <p class="product-reviews__empty vcom-reviews-proxy-empty" style="text-align:center;font-size:14px;color:#666;margin:0;">
            {{ s_empty_message}}
          </p>
        {%- endif -%}
      {%- endif -%}

      {%- if use_proxy_reviews or has_reviews == false -%}
        <script>
          (function(){
            var sid='{{ block.id }}';
            var bid='{{ bid }}';
            var grid=document.getElementById('vcom-reviews-grid-'+sid);
            if(!grid)return;
            var url=grid.getAttribute('data-proxy-url');
            if(!url)return;
            if(grid.querySelectorAll('.product-reviews__card').length>0)return;
            var starColor='{{ star_color }}';
            var starEmpty='{{ star_empty_color }}';
            var verifiedColor='{{ verified_color }}';
            var showVerified={{ s_show_verified}};
            var verifiedLabel={{ s_verified_label}};
            var titleMax={{ title_max_chars }};
            var textMax={{ text_max_chars }};
            var layout=grid.getAttribute('data-layout')||'trustpilot_carousel';
            function starSvg(stars,i){
              var idx=i+1;var min=idx-1;
              if(stars>=idx)return '<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="'+starColor+'"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>';
              if(stars>min){var w=Math.round((stars-min)*32);return '<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="'+starEmpty+'"/><rect width="'+w+'" height="32" fill="'+starColor+'"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>';}
              return '<svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="'+starEmpty+'"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>';
            }
            function esc(s){var d=document.createElement('div');d.textContent=s||'';return d.innerHTML;}
            function buildCard(rv){
              var stars=parseFloat(rv.rating)||5;
              var starsHtml='';
              for(var i=0;i<5;i++)starsHtml+=starSvg(stars,i);
              var author=rv.author||'';
              var avatar=author?author.charAt(0).toUpperCase():'?';
              var title=rv.title||'';
              var body=rv.body||'';
              var bodyShow=body.length>textMax?body.slice(0,textMax)+'...':body;
              var html='<article class="product-reviews__card">';
              html+='<div class="product-reviews__avatar" aria-hidden="true">'+esc(avatar)+'</div>';
              html+='<div class="product-reviews__card-body">';
              html+='<div class="product-reviews__head">';
              if(author)html+='<span class="product-reviews__author-name">'+esc(author)+'</span>';
              html+='<div class="product-reviews__stars" aria-hidden="true">'+starsHtml+'</div></div>';
              html+='<div class="product-reviews__stars product-reviews__stars--default" aria-hidden="true">'+starsHtml+'</div>';
              if(showVerified&&rv.verified_buyer){html+='<div class="product-reviews__verified"><span>'+esc(String(verifiedLabel))+'</span></div>';}
              if(title)html+='<h3 class="product-reviews__title">'+esc(title.length>titleMax?title.slice(0,titleMax)+'...':title)+'</h3>';
              if(body)html+='<p class="product-reviews__text">'+esc(bodyShow)+'</p>';
              html+='<div class="product-reviews__meta">';
              if(author)html+='<span class="product-reviews__meta-author">'+esc(author)+'</span>';
              if(author&&rv.time)html+='<span class="product-reviews__meta-sep"> - </span>';
              if(rv.time)html+='<span>'+esc(rv.time)+'</span>';
              html+='</div></div></article>';
              return html;
            }
            fetch(url,{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(data){
              if(!data||!data.ok||!data.reviews||!data.reviews.length)return;
              var empty=document.querySelector('#vcom-reviews-'+bid+' .vcom-reviews-proxy-empty');
              if(empty)empty.style.display='none';
              var html='';
              data.reviews.forEach(function(rv){html+=buildCard(rv);});
              grid.innerHTML=html;
              if(layout==='trustpilot_split'){
                var dist=[0,0,0,0,0];
                data.reviews.forEach(function(rv){
                  var r=Math.round(parseFloat(rv.rating)||5);
                  if(r<1)r=1;if(r>5)r=5;dist[r-1]++;
                });
                var avg=parseFloat(data.avg)||0;
                var count=data.count||data.reviews.length;
                var avgStars='';
                for(var si=0;si<5;si++)avgStars+=starSvg(avg,si);
                var bars='';
                for(var lvl=5;lvl>=1;lvl--){
                  var dc=dist[lvl-1];
                  var pct=count>0?Math.round(dc*100/count):0;
                  bars+='<div class="vcom-bar-row"><span>'+lvl+'</span><div class="vcom-bar-track"><div class="vcom-bar-fill" style="width:'+pct+'%;background:'+starColor+';"></div></div><span>'+dc+'</span></div>';
                }
                var split=document.createElement('div');
                split.className='vcom-split';
                split.innerHTML='<aside class="vcom-split__summary"><div class="vcom-split__score">'+avg.toFixed(1)+'</div><div class="product-reviews__stars" style="justify-content:center;margin-bottom:8px;">'+avgStars+'</div><p class="vcom-split__label">TrustScore</p>'+bars+'<p class="vcom-split__count">'+count+' avaliações</p></aside><div class="vcom-split__reviews"></div>';
                var col=split.querySelector('.vcom-split__reviews');
                grid.parentNode.insertBefore(split,grid);
                col.appendChild(grid);
              }
              var footer=document.querySelector('#vcom-reviews-'+bid+' .product-reviews__footer');
              if(footer&&data.count>0){
                var strongs=footer.querySelectorAll('strong');
                if(strongs[0])strongs[0].textContent=String(data.avg);
                if(strongs[1])strongs[1].textContent=data.count+(data.count>=1000?'+':'')+' customers';
              }
            }).catch(function(){});
          })();
        </script>
      {%- endif -%}

      {%- comment -%} Schema aggregateRating para SEO {%- endcomment -%}
      {%- if has_reviews and s_footer_show and product != blank and product.url != blank -%}
        <script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","@id":"{{ shop.url }}{{ product.url }}#product","aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ rating_avg | round: 1 }}","reviewCount":"{{ review_count }}","bestRating":"5"}}</script>
      {%- endif -%}

      {%- comment -%} Rodapé: calculado ou fallback {%- endcomment -%}
      {%- if s_footer_show -%}
        <p class="product-reviews__footer" id="vcom-reviews-footer-{{ block.id }}" style="margin-top:16px;font-size:14px;color:{{ s_footer_text_color}};">
          {{ s_footer_prefix}}
          <strong>{%- if has_reviews -%}{{ rating_avg | round: 1 }}{%- else -%}{{ s_footer_rating}}{%- endif -%}</strong>
          {{ s_footer_middle}}
          <strong>{%- if has_reviews -%}{{ review_count }}{%- if review_count >= 1000 -%}+{%- endif -%} customers{%- else -%}{{ s_footer_total}}{%- endif -%}</strong>{{ s_footer_suffix}}
        </p>
      {%- endif -%}

      {%- comment -%} Botão e formulário fake de envio de avaliação {%- endcomment -%}
      {%- if s_show_review_form -%}
        <div class="product-reviews__write-wrap" style="margin-top:24px;">
          <button type="button" class="product-reviews__write-btn" id="product-reviews-write-btn-{{ block.id }}" aria-expanded="false" aria-controls="product-reviews-form-{{ block.id }}" style="display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border:1px solid {{ star_color}};background:transparent;color:{{ star_color}};font-size:14px;font-weight:600;border-radius:8px;cursor:pointer;transition:background .2s,color .2s;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            {%- if s_form_btn != blank -%}{{ s_form_btn }}{%- else -%}{{ 'product_reviews.form.button' | t }}{%- endif -%}
          </button>
          <div class="product-reviews__form-outer" id="product-reviews-form-{{ block.id }}" hidden style="margin-top:16px;padding:24px;">
            <form class="product-reviews__form" id="product-reviews-form-el-{{ block.id }}" novalidate data-remove-label="{{ 'product_reviews.form.remove_image' | t }}" data-submit-url="/apps/vcom-reviews/submit" data-placement="{{ submit_placement }}" data-product-id="{{ submit_product_id }}">
              <div class="product-reviews__form-row" style="margin-bottom:16px;">
                <label for="review-rating-{{ block.id }}" style="display:block;font-size:14px;font-weight:600;margin-bottom:8px;">{%- if s_form_rating_label != blank -%}{{ s_form_rating_label }}{%- else -%}{{ 'product_reviews.form.rating_label' | t }}{%- endif -%}</label>
                <div class="product-reviews__form-stars" data-rating-input style="display:flex;gap:4px;cursor:pointer;">
                  {%- for i in (1..5) -%}
                    <button type="button" class="product-reviews__form-star" data-value-full="{{ i }}" data-value-half="{{ i | minus: 1 }}.5" aria-label="{{ 'product_reviews.form.star_rating' | t: value: i }}" style="padding:0;border:none;background:none;cursor:pointer;flex-shrink:0;">
                      <svg width="28" height="28" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect class="product-reviews__form-star-bg" width="32" height="32" fill="{{ star_empty_color }}"/><rect class="product-reviews__form-star-fill" x="0" y="0" width="0" height="32" fill="{{ star_color }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
                    </button>
                  {%- endfor -%}
                </div>
                <input type="hidden" name="rating" id="review-rating-{{ block.id }}" value="">
              </div>
              <div class="product-reviews__form-row" style="margin-bottom:16px;">
                <label for="review-title-{{ block.id }}" style="display:block;font-size:14px;font-weight:600;margin-bottom:8px;">{%- if s_form_title_label != blank -%}{{ s_form_title_label }}{%- else -%}{{ 'product_reviews.form.title_label' | t }}{%- endif -%}</label>
                <input type="text" id="review-title-{{ block.id }}" name="title" placeholder="{%- if s_form_title_ph != blank -%}{{ s_form_title_ph }}{%- else -%}{{ 'product_reviews.form.title_placeholder' | t }}{%- endif -%}" style="width:100%;padding:10px 12px;border:1px solid {{ s_form_input_border }};border-radius:6px;font-size:14px;">
              </div>
              <div class="product-reviews__form-row" style="margin-bottom:16px;">
                <label for="review-body-{{ block.id }}" style="display:block;font-size:14px;font-weight:600;margin-bottom:8px;">{%- if s_form_body_label != blank -%}{{ s_form_body_label }}{%- else -%}{{ 'product_reviews.form.body_label' | t }}{%- endif -%}</label>
                <textarea id="review-body-{{ block.id }}" name="body" rows="4" placeholder="{%- if s_form_body_ph != blank -%}{{ s_form_body_ph }}{%- else -%}{{ 'product_reviews.form.body_placeholder' | t }}{%- endif -%}" style="width:100%;padding:10px 12px;border:1px solid {{ s_form_input_border }};border-radius:6px;font-size:14px;resize:vertical;"></textarea>
              </div>
              {%- if s_form_show_images -%}
              <div class="product-reviews__form-row product-reviews__form-images-row" style="margin-bottom:16px;">
                <label style="display:block;font-size:14px;font-weight:600;margin-bottom:8px;">{%- if s_form_images_label != blank -%}{{ s_form_images_label }}{%- else -%}{{ 'product_reviews.form.images_label' | t }}{%- endif -%}</label>
                <input type="file" id="review-images-{{ block.id }}" name="images" accept="image/*" multiple class="product-reviews__form-file" style="display:none;">
                <button type="button" class="product-reviews__form-add-images" style="display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border:2px dashed #d1d5db;background:#fff;border-radius:8px;font-size:14px;color:#6b7280;cursor:pointer;transition:border-color .2s,color .2s;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                  {%- if s_form_images_btn != blank -%}{{ s_form_images_btn }}{%- else -%}{{ 'product_reviews.form.images_btn' | t }}{%- endif -%}
                </button>
                <div class="product-reviews__form-images-preview" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;"></div>
              </div>
              {%- endif -%}
              <div class="product-reviews__form-row" style="margin-bottom:20px;">
                <label for="review-author-{{ block.id }}" style="display:block;font-size:14px;font-weight:600;margin-bottom:8px;">{%- if s_form_author_label != blank -%}{{ s_form_author_label }}{%- else -%}{{ 'product_reviews.form.author_label' | t }}{%- endif -%}</label>
                <input type="text" id="review-author-{{ block.id }}" name="author" placeholder="{%- if s_form_author_ph != blank -%}{{ s_form_author_ph }}{%- else -%}{{ 'product_reviews.form.author_placeholder' | t }}{%- endif -%}" style="width:100%;padding:10px 12px;border:1px solid {{ s_form_input_border }};border-radius:6px;font-size:14px;">
              </div>
              <div class="product-reviews__form-actions" style="display:flex;gap:12px;flex-wrap:wrap;">
                <button type="submit" style="padding:12px 24px;background:{{ star_color}};color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;">{%- if s_form_submit != blank -%}{{ s_form_submit }}{%- else -%}{{ 'product_reviews.form.submit' | t }}{%- endif -%}</button>
                <button type="button" class="product-reviews__form-cancel" style="padding:12px 24px;background:#fff;color:#6b7280;border:1px solid #d1d5db;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;">{%- if s_form_cancel != blank -%}{{ s_form_cancel }}{%- else -%}{{ 'product_reviews.form.cancel' | t }}{%- endif -%}</button>
              </div>
            </form>
          </div>
          <div class="product-reviews__form-error" id="product-reviews-error-{{ block.id }}" hidden style="margin-top:16px;padding:16px 20px;background:#fef2f2;border:1px solid #fecaca;border-radius:10px;color:#991b1b;font-size:14px;"></div>
          {%- if s_form_show_success -%}
          <div class="product-reviews__form-success" id="product-reviews-success-{{ block.id }}" hidden style="margin-top:16px;padding:20px 24px;font-weight:500;display:flex;align-items:center;gap:10px;" data-show-success="true">
            {%- if s_success_show_icon -%}
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            {%- endif -%}
            <span class="product-reviews__form-success-text">
              {%- if s_form_success != blank -%}{{ s_form_success }}{%- else -%}{{ 'product_reviews.form.pending_success' | t }}{%- endif -%}
            </span>
          </div>
          {%- endif -%}
        </div>
        <style>
          #vcom-reviews-{{ bid }} .product-reviews__write-btn:hover{background:{{ star_color}};color:#fff}
          #vcom-reviews-{{ bid }} .product-reviews__form-star .product-reviews__form-star-bg{fill:{{ star_empty_color }}}#vcom-reviews-{{ bid }} .product-reviews__form-star .product-reviews__form-star-fill{fill:{{ star_color }};transition:width .15s ease}
          #vcom-reviews-{{ bid }} .product-reviews__form-add-images:hover{border-color:{{ star_color}};color:{{ star_color}}}
          #vcom-reviews-{{ bid }} .product-reviews__form-img-preview{position:relative;width:72px;height:72px;border-radius:8px;overflow:hidden;border:1px solid #e5e7eb}
          #vcom-reviews-{{ bid }} .product-reviews__form-img-preview img{width:100%;height:100%;object-fit:cover;display:block}
          #vcom-reviews-{{ bid }} .product-reviews__form-img-remove{position:absolute;top:4px;right:4px;width:22px;height:22px;border:none;background:rgba(0,0,0,.6);color:#fff;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;font-size:14px;line-height:1}
        </style>
        <script>
          (function(){
            var sid='{{ block.id }}';
            var btn=document.getElementById('product-reviews-write-btn-'+sid);
            var formOuter=document.getElementById('product-reviews-form-'+sid);
            var formEl=document.getElementById('product-reviews-form-el-'+sid);
            var successEl=document.getElementById('product-reviews-success-'+sid);
            var showSuccess=!!(successEl&&successEl.getAttribute('data-show-success')==='true');
            var errorEl=document.getElementById('product-reviews-error-'+sid);
            var submitUrl=formEl.getAttribute('data-submit-url')||'/apps/vcom-reviews/submit';
            var placement=formEl.getAttribute('data-placement')||'homepage';
            var productId=formEl.getAttribute('data-product-id')||'';
            var cancelBtn=formOuter&&formOuter.querySelector('.product-reviews__form-cancel');
            var starBtns=formOuter&&formOuter.querySelectorAll('.product-reviews__form-star');
            var ratingInput=formOuter&&formOuter.querySelector('[name="rating"]');
            var fileInput=formOuter&&formOuter.querySelector('.product-reviews__form-file');
            var addImagesBtn=formOuter&&formOuter.querySelector('.product-reviews__form-add-images');
            var imagesPreview=formOuter&&formOuter.querySelector('.product-reviews__form-images-preview');
            var maxImages={{ s_form_images_max}};
            if(!btn||!formOuter||!formEl)return;
            function openForm(){formOuter.hidden=false;if(successEl)successEl.hidden=true;if(errorEl)errorEl.hidden=true;btn.setAttribute('aria-expanded','true');btn.style.display='none';}
            function closeForm(){formOuter.hidden=true;if(successEl)successEl.hidden=!showSuccess;if(errorEl)errorEl.hidden=true;btn.setAttribute('aria-expanded','false');btn.style.display='inline-flex';}
            function showError(msg){if(errorEl){errorEl.textContent=msg||'Erro ao enviar.';errorEl.hidden=false;}if(successEl)successEl.hidden=true;}
            function clearImages(){if(fileInput){fileInput.value='';}if(imagesPreview){imagesPreview.innerHTML='';}}
            function setStarDisplay(val){var r=parseFloat(val)||0;starBtns&&starBtns.forEach(function(btn,i){var idx=i+1;var fill=btn.querySelector('.product-reviews__form-star-fill');if(!fill)return;if(r>=idx)fill.setAttribute('width',32);else if(r>=idx-0.5)fill.setAttribute('width',16);else fill.setAttribute('width',0);});}
            function resetForm(){formEl.reset();if(ratingInput)ratingInput.value='';setStarDisplay(0);clearImages();}
            btn.addEventListener('click',function(){openForm();resetForm();});
            cancelBtn&&cancelBtn.addEventListener('click',function(){formOuter.hidden=true;btn.setAttribute('aria-expanded','false');btn.style.display='inline-flex';if(successEl)successEl.hidden=true;resetForm();});
            starBtns&&starBtns.forEach(function(btn){
              btn.addEventListener('click',function(e){var rect=this.getBoundingClientRect();var x=e.clientX-rect.left;var isLeftHalf=x<rect.width/2;var vFull=parseFloat(this.getAttribute('data-value-full'));var vHalf=parseFloat(this.getAttribute('data-value-half'));var v=isLeftHalf?vHalf:vFull;ratingInput.value=v;setStarDisplay(v);});
            });
            if(addImagesBtn&&fileInput&&imagesPreview){addImagesBtn.addEventListener('click',function(){fileInput.click();});fileInput.addEventListener('change',function(){var files=Array.prototype.slice.call(this.files,0,maxImages);imagesPreview.innerHTML='';files.forEach(function(f){var fr=new FileReader();fr.onload=function(){var div=document.createElement('div');div.className='product-reviews__form-img-preview';var rmLabel=(formEl.getAttribute('data-remove-label')||'Remove');div.innerHTML='<img src="'+fr.result+'" alt=""><button type="button" class="product-reviews__form-img-remove" aria-label="'+rmLabel+'">&times;</button>';var rm=div.querySelector('.product-reviews__form-img-remove');rm.addEventListener('click',function(){div.remove();var dt=new DataTransfer();Array.from(fileInput.files).forEach(function(x){if(x!==f)dt.items.add(x);});fileInput.files=dt.files;});imagesPreview.appendChild(div);};fr.readAsDataURL(f);});});}
            formEl.addEventListener('submit',function(e){
              e.preventDefault();
              if(errorEl)errorEl.hidden=true;
              var ratingVal=parseFloat(ratingInput&&ratingInput.value)||0;
              if(!ratingVal||ratingVal<0.5){showError('Selecione uma nota.');return;}
              var bodyVal=formEl.querySelector('[name="body"]');
              var authorVal=formEl.querySelector('[name="author"]');
              if(!bodyVal||!bodyVal.value.trim()||!authorVal||!authorVal.value.trim()){showError('Preencha nome e texto.');return;}
              var fd=new FormData(formEl);
              fd.set('placement',placement);
              if(productId)fd.set('product_id',productId);
              var submitBtn=formEl.querySelector('[type="submit"]');
              if(submitBtn){submitBtn.disabled=true;submitBtn.textContent='Enviando…';}
              fetch(submitUrl,{method:'POST',body:fd,credentials:'same-origin'})
                .then(function(r){return r.json().then(function(data){return {ok:r.ok,data:data};});})
                .then(function(res){
                  if(submitBtn){submitBtn.disabled=false;submitBtn.textContent=submitBtn.getAttribute('data-label')||'Enviar';}
                  if(res.data&&res.data.ok){closeForm();}
                  else{showError((res.data&&res.data.error)||'Não foi possível enviar.');}
                })
                .catch(function(){if(submitBtn){submitBtn.disabled=false;}showError('Erro de conexão. Tente novamente.');});
            });
            var submitBtnInit=formEl.querySelector('[type="submit"]');
            if(submitBtnInit&&!submitBtnInit.getAttribute('data-label')){submitBtnInit.setAttribute('data-label',submitBtnInit.textContent);}
          })();
        </script>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Avaliações VCOM",
  "target": "section",
  "settings": []
}
{% endschema %}
