<script>
(function () {
  function getFooterSection() {
    return (
      document.querySelector(
        '#shopify-section-group-footer-group section.shopify-section--footer',
      ) || document.querySelector('section.shopify-section--footer')
    );
  }

  function nativeHasContent(el) {
    if (!el) return false;
    return !!(el.querySelector('img, svg') || (el.textContent && el.textContent.trim().length > 8));
  }

  function showBadge(badge) {
    badge.classList.remove('vcom-footer-trustpilot--pending');
    badge.classList.add('vcom-footer-trustpilot--placed');
    badge.dataset.vcomPlaced = '1';
  }

  function hideAppHosts(footerRoot) {
    footerRoot.querySelectorAll('.footer__block--app, .vcom-footer-app-host').forEach(function (host) {
      var hasBadge = host.querySelector('.vcom-footer-trustpilot--app');
      if (!hasBadge || host.querySelector('.vcom-footer-trustpilot--placed')) {
        host.setAttribute('hidden', 'hidden');
        host.style.cssText = 'display:none !important;height:0;margin:0;padding:0;border:0;overflow:hidden;';
      }
    });
  }

  function ensureBrandSlot(footerRoot) {
    var textBlock = footerRoot.querySelector('.footer__block--text');
    if (!textBlock) return null;

    var slot = textBlock.querySelector('.footer__brand-social-trustpilot');
    if (!slot) {
      slot = document.createElement('div');
      slot.className = 'footer__brand-social-trustpilot v-stack gap-4';
      slot.style.cssText = 'align-items:flex-start;margin-top:var(--spacing-4,1rem);';
      textBlock.appendChild(slot);
    }

    var socialInSlot = slot.querySelector('.social-media');
    var socialInText = textBlock.querySelector(':scope > .social-media, :scope > .v-stack .social-media');
    var socialAside = footerRoot.querySelector('.footer__aside .social-media');

    if (!socialInSlot) {
      if (socialInText && !slot.contains(socialInText)) {
        slot.appendChild(socialInText);
      } else if (socialAside && footerRoot.dataset.vcomSocialMoved !== '1') {
        slot.appendChild(socialAside);
        footerRoot.dataset.vcomSocialMoved = '1';
      }
    }

    return slot;
  }

  function placeFooterTrustpilot() {
    var badges = document.querySelectorAll('.vcom-footer-trustpilot--app');
    if (!badges.length) return;

    var footerSection = getFooterSection();
    if (!footerSection) {
      badges.forEach(showBadge);
      return;
    }

    var footerRoot = footerSection.querySelector('.footer');
    if (!footerRoot) {
      badges.forEach(showBadge);
      return;
    }

    var native = footerRoot.querySelector(
      '.vcom-footer-trustpilot:not(.vcom-footer-trustpilot--app)',
    );
    if (nativeHasContent(native)) {
      badges.forEach(function (el) {
        el.remove();
      });
      hideAppHosts(footerRoot);
      return;
    }

    var badge = badges[0];
    for (var i = 1; i < badges.length; i++) {
      badges[i].remove();
    }

    var slot = ensureBrandSlot(footerRoot);
    if (!slot) {
      showBadge(badge);
      return;
    }

    if (badge.parentElement !== slot) {
      slot.appendChild(badge);
    }

    showBadge(badge);
    hideAppHosts(footerRoot);
  }

  function schedulePlace() {
    placeFooterTrustpilot();
    window.setTimeout(placeFooterTrustpilot, 150);
    window.setTimeout(placeFooterTrustpilot, 600);
    window.setTimeout(placeFooterTrustpilot, 1500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', schedulePlace);
  } else {
    schedulePlace();
  }
  document.addEventListener('shopify:section:load', schedulePlace);
})();
</script>
