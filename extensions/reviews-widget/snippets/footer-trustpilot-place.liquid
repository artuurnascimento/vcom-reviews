<script>
(function () {
  function getFooterSection() {
    return (
      document.querySelector(
        '#shopify-section-group-footer-group section.shopify-section--footer',
      ) || document.querySelector('section.shopify-section--footer')
    );
  }

  function nativeHasContent(el) {
    if (!el) return false;
    return !!(el.querySelector('img, svg') || (el.textContent && el.textContent.trim().length > 8));
  }

  function showBadge(badge) {
    badge.classList.remove('vcom-footer-trustpilot--pending');
    badge.classList.add('vcom-footer-trustpilot--placed');
    badge.dataset.vcomPlaced = '1';
  }

  function findTargetSocial(footerRoot) {
    var textBlock = footerRoot.querySelector('.footer__block--text');
    if (textBlock) {
      var inText = textBlock.querySelector('.social-media');
      if (inText) return { social: inText, column: textBlock };
    }

    var brandSlot = footerRoot.querySelector('.footer__brand-social-trustpilot');
    if (brandSlot) {
      var inBrand = brandSlot.querySelector('.social-media');
      if (inBrand) return { social: inBrand, column: brandSlot };
      return { social: null, column: brandSlot };
    }

    var asideSocial = footerRoot.querySelector('.footer__aside .social-media');
    if (asideSocial) {
      var asideStack =
        asideSocial.closest('.v-stack') ||
        asideSocial.closest('.footer__aside-top') ||
        asideSocial.parentElement;
      return { social: asideSocial, column: asideStack || asideSocial.parentElement };
    }

    var anySocial = footerRoot.querySelector('.social-media');
    if (anySocial) {
      return { social: anySocial, column: anySocial.parentElement };
    }

    if (textBlock) return { social: null, column: textBlock };
    return { social: null, column: footerRoot.querySelector('.footer__block-list') || footerRoot };
  }

  function placeFooterTrustpilot() {
    var badges = document.querySelectorAll('.vcom-footer-trustpilot--app');
    if (!badges.length) return;

    var footerSection = getFooterSection();
    if (!footerSection) {
      badges.forEach(showBadge);
      return;
    }

    var footerRoot = footerSection.querySelector('.footer');
    if (!footerRoot) {
      badges.forEach(showBadge);
      return;
    }

    var native = footerRoot.querySelector(
      '.vcom-footer-trustpilot:not(.vcom-footer-trustpilot--app)',
    );
    if (nativeHasContent(native)) {
      badges.forEach(function (el) {
        el.remove();
      });
      return;
    }

    var badge = badges[0];
    for (var i = 1; i < badges.length; i++) {
      badges[i].remove();
    }

    if (badge.dataset.vcomPlaced === '1') return;

    var target = findTargetSocial(footerRoot);
    if (!target.column) {
      showBadge(badge);
      return;
    }

    var brandSlot = footerRoot.querySelector('.footer__brand-social-trustpilot');
    if (brandSlot && !brandSlot.contains(badge)) {
      brandSlot.appendChild(badge);
      showBadge(badge);
      return;
    }

    if (target.social && !target.social.parentElement.contains(badge)) {
      target.social.insertAdjacentElement('afterend', badge);
      showBadge(badge);
      return;
    }

    if (target.column && !target.column.contains(badge)) {
      target.column.appendChild(badge);
    }
    showBadge(badge);
  }

  function schedulePlace() {
    placeFooterTrustpilot();
    window.setTimeout(placeFooterTrustpilot, 120);
    window.setTimeout(placeFooterTrustpilot, 500);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', schedulePlace);
  } else {
    schedulePlace();
  }
  document.addEventListener('shopify:section:load', schedulePlace);

  if (typeof MutationObserver !== 'undefined') {
    var observer = new MutationObserver(function () {
      placeFooterTrustpilot();
    });
    observer.observe(document.documentElement, { childList: true, subtree: true });
    window.setTimeout(function () {
      observer.disconnect();
    }, 8000);
  }
})();
</script>
