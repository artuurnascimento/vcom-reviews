{%- liquid
  assign link_only = link_only | default: false
  if link_only
    break
  endif
  assign force_show = force_show | default: false
  assign cfg = shop.metafields.vcom_reviews.storefront_settings.value
  assign tp_show = false
  if force_show
    assign tp_show = true
  elsif cfg != blank
    if cfg.footer_trustpilot_show == true or cfg.footer_trustpilot_show == 'true' or cfg.footer_trustpilot_show == 1
      assign tp_show = true
    endif
  endif
  if request.design_mode and cfg != blank
    assign tp_show = true
  endif
-%}
{%- if tp_show -%}
{%- if cfg == blank -%}
  {%- assign display_rating = '4.8' -%}
  {%- assign display_count = 0 -%}
  {%- assign tp_logo_h = 20 -%}
  {%- assign tp_stars = '#00B67A' -%}
  {%- assign tp_stars_empty = '#dcdce6' -%}
  {%- assign tp_text = '#191919' -%}
  {%- assign tp_muted = '#6b6b6b' -%}
  {%- assign tp_score_label = 'TrustScore' -%}
  {%- assign tp_reviews_word = 'reviews' -%}
  {%- assign header_stars = 4.8 -%}
{%- else -%}
{%- assign tp_logo_h = cfg.footer_trustpilot_logo_height | default: 20 -%}
{%- assign tp_stars = cfg.footer_trustpilot_stars_color | default: cfg.stars_color | default: '#00B67A' -%}
{%- if tp_stars == blank -%}{%- assign tp_stars = '#00B67A' -%}{%- endif -%}
{%- assign tp_stars_empty = cfg.stars_empty_color | default: '#dcdce6' -%}
{%- assign tp_text = cfg.footer_trustpilot_text_color | default: '#191919' -%}
{%- assign tp_muted = cfg.footer_trustpilot_muted_color | default: '#6b6b6b' -%}
{%- assign tp_score_label = cfg.footer_trustpilot_score_label | default: 'TrustScore' -%}
{%- assign tp_reviews_word = cfg.footer_trustpilot_reviews_word | default: 'reviews' -%}

{%- assign mo_count_review = 0 -%}
{%- assign mo_count_app = 0 -%}
{%- if shop.metaobjects.review -%}
  {%- assign mo_count_review = shop.metaobjects.review.values_count | default: 0 -%}
{%- endif -%}
{%- if shop.metaobjects["$app:review"] -%}
  {%- assign mo_count_app = shop.metaobjects["$app:review"].values_count | default: 0 -%}
{%- endif -%}
{%- assign all_reviews = nil -%}
{%- assign vcom_review_mo = nil -%}
{%- if mo_count_app > mo_count_review and shop.metaobjects["$app:review"] -%}
  {%- assign vcom_review_mo = shop.metaobjects["$app:review"] -%}
{%- elsif shop.metaobjects.review -%}
  {%- assign vcom_review_mo = shop.metaobjects.review -%}
{%- elsif shop.metaobjects["$app:review"] -%}
  {%- assign vcom_review_mo = shop.metaobjects["$app:review"] -%}
{%- endif -%}
{%- if vcom_review_mo -%}
  {%- paginate vcom_review_mo.values by 250 -%}
    {%- assign all_reviews = vcom_review_mo.values -%}
  {%- endpaginate -%}
{%- endif -%}

{%- assign review_count = 0 -%}
{%- assign rating_sum = 0 -%}
{%- if all_reviews != blank -%}
  {%- for r in all_reviews -%}
    {%- assign r_st = 'approved' -%}
    {%- if r.status != blank -%}{%- assign r_st = r.status.value | default: r.status -%}{%- endif -%}
    {%- if r_st == 'pending' or r_st == 'rejected' -%}{%- continue -%}{%- endif -%}
    {%- assign r_pl = 'homepage' -%}
    {%- if r.placement != blank -%}{%- assign r_pl = r.placement.value | default: r.placement -%}{%- endif -%}
    {%- unless r_pl == 'homepage' -%}{%- continue -%}{%- endunless -%}
    {%- assign review_count = review_count | plus: 1 -%}
    {%- assign r_val_raw = r.rating.value | default: r.rating | replace: ',', '.' -%}
    {%- assign rating_sum = rating_sum | plus: r_val_raw | plus: 0.0 -%}
  {%- endfor -%}
{%- endif -%}

{%- assign display_rating = cfg.footer_rating | default: '4.8' -%}
{%- if review_count > 0 -%}
  {%- assign display_rating = rating_sum | times: 1.0 | divided_by: review_count | round: 1 -%}
{%- endif -%}
{%- assign header_stars = display_rating | plus: 0.0 -%}
{%- assign display_count = mo_count_review | default: 0 -%}
{%- assign mo_app_total = mo_count_app | default: 0 -%}
{%- if mo_app_total > display_count -%}{%- assign display_count = mo_app_total -%}{%- endif -%}
{%- assign vcom_stats = shop.metafields.vcom_reviews.storefront_stats.value -%}
{%- comment -%} Nota do site inteiro (all_avg). O filtro default nao troca zero, entao testa > 0. {%- endcomment -%}
{%- if vcom_stats != blank -%}
  {%- if vcom_stats.all_avg != blank and vcom_stats.all_avg > 0 -%}
    {%- assign display_rating = vcom_stats.all_avg -%}
    {%- assign header_stars = display_rating | plus: 0.0 -%}
  {%- elsif vcom_stats.homepage_avg != blank and vcom_stats.homepage_avg > 0 -%}
    {%- assign display_rating = vcom_stats.homepage_avg -%}
    {%- assign header_stars = display_rating | plus: 0.0 -%}
  {%- endif -%}
{%- endif -%}
{%- if display_count == 0 -%}
  {%- assign display_count = cfg.footer_trustpilot_fallback_count | default: 0 -%}
{%- endif -%}
{%- endif -%}

<div class="vcom-footer-trustpilot vcom-footer-trustpilot--app vcom-footer-trustpilot--pending" style="color:{{ tp_text }};">
  <img
    class="vcom-footer-trustpilot__logo"
    src="{{ 'trustpilot-logo-white.svg' | asset_url }}"
    alt="Trustpilot"
    width="83"
    height="{{ tp_logo_h }}"
    loading="lazy"
    style="height:{{ tp_logo_h }}px;width:auto;display:block;margin-bottom:10px;"
  >
  <div class="vcom-footer-trustpilot__stars" aria-hidden="true" style="display:flex;gap:4px;margin-bottom:8px;">
    {%- for i in (1..5) -%}
      {%- assign star_min = i | minus: 1 | times: 1.0 -%}
      {%- if header_stars >= i -%}
        <svg width="20" height="20" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ tp_stars }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
      {%- elsif header_stars > star_min -%}
        {%- assign pct = header_stars | minus: star_min -%}
        {%- assign fill_width = pct | times: 32 -%}
        <svg width="20" height="20" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ tp_stars_empty }}"/><rect width="{{ fill_width }}" height="32" fill="{{ tp_stars }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
      {%- else -%}
        <svg width="20" height="20" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><rect width="32" height="32" fill="{{ tp_stars_empty }}"/><path d="M9.2 27L16 21.807 22.797 27 20.202 18.596 27 13.403h-8.402L16 5l-2.597 8.403H5l6.798 5.193L9.2 27z" fill="#fff"/></svg>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <p class="vcom-footer-trustpilot__score" style="margin:0;font-size:14px;line-height:1.4;color:#EEF1F5;">
    <span style="color:#EEF1F5;">{{ tp_score_label }}</span>
    <strong style="font-weight:700;color:#FFFFFF;"> {{ display_rating }}</strong>
    {%- if display_count > 0 -%}
{%- assign m_brand=cfg.modal_brand_name|default:''-%}{%- assign m_logo=cfg.modal_brand_logo_url|default:''-%}{%- assign m_cat=cfg.modal_category|default:''-%}{%- assign m_accent=cfg.modal_accent_color|default:''-%}{%- assign m_wr='1'-%}{%- if cfg.modal_show_write_review==false-%}{%- assign m_wr='0'-%}{%- endif-%}{%- assign m_sum='1'-%}{%- if cfg.modal_show_summary==false-%}{%- assign m_sum='0'-%}{%- endif-%}{%- assign m_th='1'-%}{%- if cfg.modal_show_themes==false-%}{%- assign m_th='0'-%}{%- endif-%}{%- assign m_disc='1'-%}{%- if cfg.modal_show_disclosure==false-%}{%- assign m_disc='0'-%}{%- endif-%}{%- assign m_dt=cfg.modal_disclosure_title|default:''-%}{%- assign m_db=cfg.modal_disclosure_body|default:''-%}{%- assign m_size=cfg.modal_brand_logo_size|default:30-%}{%- assign m_pos=cfg.modal_brand_position|default:'left'-%}{%- assign m_disp=cfg.modal_brand_display|default:'both'-%}
      <button type="button" class="vcom-footer-trustpilot__count" data-vcom-reviews-modal data-shop-name="{{ shop.name | escape }}" data-shop-url="{{ shop.url }}" data-app-logo="{{ 'vcom-app-logo.svg' | asset_url }}" data-shop-category="{{ m_cat | escape }}" data-brand-name="{{ m_brand | escape }}"{%- if m_logo != blank %} data-brand-logo="{{ m_logo | escape }}"{%- endif %}{%- if m_accent != blank %} data-accent-color="{{ m_accent | escape }}"{%- endif %} data-show-write="{{ m_wr }}" data-show-summary="{{ m_sum }}" data-show-themes="{{ m_th }}" data-show-disclosure="{{ m_disc }}" data-brand-logo-size="{{ m_size }}" data-brand-position="{{ m_pos }}" data-brand-display="{{ m_disp }}"{%- if m_dt != blank %} data-disclosure-title="{{ m_dt | escape }}"{%- endif %}{%- if m_db != blank %} data-disclosure-body="{{ m_db | escape }}"{%- endif %}{%- if shop.brand.square_logo != blank %} data-shop-logo="{{ shop.brand.square_logo | image_url: width: 200 }}"{%- elsif shop.brand.logo != blank %} data-shop-logo="{{ shop.brand.logo | image_url: width: 200 }}"{%- endif %} style="color:#EEF1F5;text-decoration:underline;text-underline-offset:2px;background:none;border:0;padding:0;margin-left:4px;font:inherit;cursor:pointer;">{{ display_count }}{% if display_count >= 1000 %}+{% endif %} {{ tp_reviews_word }}</button>
    {%- endif -%}
  </p>
</div>
<style>
  .vcom-footer-trustpilot-stack {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: flex-start !important;
    gap: 12px !important;
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 auto !important;
    align-self: flex-start !important;
  }
  .vcom-footer-trustpilot-slot {
    display: block !important;
    width: 100% !important;
    max-width: 320px !important;
    flex: 0 0 auto !important;
    clear: both !important;
  }
  .vcom-footer-trustpilot--pending {
    opacity: 0;
    pointer-events: none;
    max-height: 0;
    overflow: hidden;
  }
  .vcom-footer-trustpilot--placed {
    display: block !important;
    opacity: 1;
    pointer-events: auto;
    max-height: none;
    overflow: visible;
    width: 100% !important;
    max-width: 320px;
    flex: 0 0 auto !important;
    margin-top: 0;
  }
</style>
{{ 'vcom-reviews-modal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vcom-reviews-modal.js' | asset_url }}" defer></script>
{%- endif -%}
