SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SCOPES=read_metaobject_definitions,write_metaobject_definitions,read_metaobjects,write_metaobjects,read_files,write_files,read_products,read_themes,write_themes

# Obrigatório em produção (Railway, Render, etc.). Sem barra no final.
# Ex.: https://vcom-reviews-production.up.railway.app
SHOPIFY_APP_URL=https://your-public-host.example.com

# Persistencia de sessoes em producao (recomendado)
DATABASE_URL=postgres://user:password@host:5432/database

# Cache distribuido entre replicas (opcional local, recomendado em producao)
REDIS_URL=redis://default:password@host:6379

# Observabilidade de erros (Sentry)
# SENTRY_DSN=https://public_key@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Endpoint seguro para smoke test do Sentry em produção
# ENABLE_SENTRY_TEST_ENDPOINT=1
# SENTRY_TEST_TOKEN=defina-um-token-forte-aqui

# Google Gemini — geração de avaliações com IA (billing ativo recomendado em produção)
GEMINI_API_KEY=your_gemini_api_key
# Padrão: gemini-2.5-flash-lite (melhor cota no free tier). Qualidade: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
# Lotes paralelos no servidor (padrão: 1). Só aumente com billing ativo. Máx. 8.
# GEMINI_BATCH_CONCURRENCY=5
# Free tier (~5 RPM no flash): serializa lotes com ~13s entre chamadas
# GEMINI_FREE_TIER=1
# GEMINI_BATCH_DELAY_MS=13000

# Só no servidor (Railway). Não use em .env local — quebra `npm install` / gera aviso do npm.
# NODE_ENV=production
